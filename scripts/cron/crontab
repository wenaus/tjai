# tjai ec2dev cron jobs
# Install: crontab /home/admin/github/tjrepo/tjai/scripts/cron/crontab
# Source: tjrepo/tjai/scripts/cron/

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Every 30 min — pull every repo in ~/github (swf-* tracks highest infra/baseline-vNN)
*/30 * * * * flock -n /tmp/git_pull_repos.lock /home/admin/github/tjrepo/tjai/scripts/cron/git_pull_repos.sh >> /tmp/cron_git_pull.log 2>&1

# Every 5 min — pull swf-* repos only: this machine collaborates with live
# swf development and must not operate on 30-min-stale swf software.
*/5 * * * * flock -n /tmp/git_pull_repos.lock /home/admin/github/tjrepo/tjai/scripts/cron/git_pull_repos.sh swf-only >> /tmp/cron_git_pull_swf.log 2>&1

# Daily 03:00 — generate dev activity (upstream repo commits)
0 3 * * * /var/www/tjai/.venv/bin/python /home/admin/github/tjrepo/tjai/scripts/section_dev.py >> /tmp/cron_section_dev.log 2>&1

# Daily 04:00 — purge Claude Code session detritus older than 2 days
0 4 * * * /home/admin/github/tjrepo/tjai/scripts/cron/cleanup_claude_sessions.sh >> /tmp/cron_cleanup_claude.log 2>&1

# Daily 03:30 — purge entry versions older than 3 days (keep min 2 per entry)
30 3 * * * /home/admin/github/tjrepo/tjai/scripts/cron/purge_old_versions.py >> /tmp/cron_purge_versions.log 2>&1

# Daily 03:45 — prune applog (info >7d, error >14d) and health-digest files (>7d)
45 3 * * * /home/admin/github/tjrepo/tjai/scripts/cron/prune_logs_and_digests.py >> /tmp/cron_prune_logs.log 2>&1

# Every 10 min — sync user accounts from swf-remote to corun-ai
*/10 * * * * /var/www/corun-ai/scripts/sync_users.sh >> /tmp/cron_sync_users.log 2>&1

# Daily 02:30 — heal any empty git_daily .md files from prior days (page-load
# refresh covers today+yesterday; this catches older days whose file was
# written before that day's commits happened).
30 2 * * * /var/www/tjai/.venv/bin/python /var/www/tjai/scripts/cron/refresh_git_daily.py >> /tmp/cron_refresh_git_daily.log 2>&1

# Daily 02:40 — weekly lines-added-by-project data for the git page chart
40 2 * * * /var/www/tjai/.venv/bin/python /var/www/tjai/scripts/cron/refresh_git_weekly_loc.py >> /tmp/cron_git_weekly_loc.log 2>&1
