# Environment configuration for tjai
# Copy this file to .env and edit values.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-strong-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,etaverse.com
DJANGO_DATABASE_URL=postgres://tjai:changeme@localhost:5432/tjai
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_CSRF_TRUSTED_ORIGINS=https://etaverse.com,http://etaverse.com
DJANGO_LOG_LEVEL=INFO

# Path settings when served under a subpath
DJANGO_FORCE_SCRIPT_NAME=/tjai
DJANGO_STATIC_URL=/tjai/static/

# Cookie flags (tune per environment)
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_PATH=/tjai
DJANGO_SESSION_COOKIE_PATH=/tjai
